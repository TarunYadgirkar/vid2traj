<mujoco model="so101 viz scene">
  <!-- Visualization-only scene: adds a floor, lights, and a studio backdrop.
       The safety and kinematics layers load so_arm100.xml directly, without a
       floor, so this scene can never introduce a spurious ground contact. -->
  <include file="so_arm100.xml"/>

  <visual>
    <headlight diffuse="0.45 0.45 0.5" ambient="0.28 0.28 0.33" specular="0.1 0.1 0.1"/>
    <rgba haze="0.09 0.10 0.13 1"/>
    <quality shadowsize="4096" offsamples="8"/>
    <map shadowclip="1.2"/>
    <global offwidth="1920" offheight="1440" azimuth="45" elevation="-22"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.13 0.15 0.20" rgb2="0.03 0.04 0.06"
      width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.19 0.21 0.26"
      rgb2="0.16 0.18 0.22" markrgb="0.33 0.36 0.44" width="512" height="512"/>
    <material name="grid" texture="grid" texuniform="true" texrepeat="14 14" reflectance="0.12"/>
  </asset>

  <worldbody>
    <light name="key" pos="1.2 -1.0 2.2" dir="-0.4 0.35 -1" directional="true"
      diffuse="0.55 0.55 0.58" specular="0.2 0.2 0.2" castshadow="true"/>
    <light name="fill" pos="-1.4 1.2 1.8" dir="0.5 -0.45 -1" directional="true"
      diffuse="0.22 0.24 0.30" specular="0.0 0.0 0.0" castshadow="false"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="grid" pos="0 0 0"/>
  </worldbody>
</mujoco>
